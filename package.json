{
  "name": "richtext",
  "private": true,
  "version": "1.0.0",
  "description": "Cross-platform Slack-like rich text engine for Web, iOS, and Android",
  "workspaces": [
    "packages/core",
    "packages/web",
    "apps/web"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:core": "npm test -w @company/rich-text-core",
    "test:web": "npm test -w @company/rich-text-web",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @company/rich-text-web-example",
    "example:web": "npm run dev -w @company/rich-text-web-example"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
